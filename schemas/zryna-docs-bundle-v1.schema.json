{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zryna.com/schemas/zryna-docs-bundle-v1.schema.json",
  "title": "Zryna compiler documentation bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "channel", "source", "documents"],
  "properties": {
    "schema": { "const": "zryna.docs.bundle.v1" },
    "version": { "const": 1 },
    "channel": {
      "type": "string",
      "pattern": "^(?:next|playground-0\\.1\\.0|(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:(?:0|[1-9][0-9]*)|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?)$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "ref", "version"],
      "properties": {
        "repository": { "const": "https://github.com/zryna/zryna" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "ref": {
          "type": "string",
          "pattern": "^refs/(?:heads/main|tags/playground-v0\\.1\\.0|tags/v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:(?:0|[1-9][0-9]*)|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?)$"
        },
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:(?:0|[1-9][0-9]*)|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?$"
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "title", "bytes", "sha256"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[/-][a-z0-9]+(?:-[a-z0-9]+)*)*$",
            "maxLength": 160
          },
          "path": {
            "type": "string",
            "pattern": "^documents/[a-z0-9]+(?:[/-][a-z0-9]+(?:-[a-z0-9]+)*)*\\.md$",
            "maxLength": 240
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[^\\r\\n]+$"
          },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 2097152 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "channel": { "const": "playground-0.1.0" } } },
      "then": { "properties": { "source": { "type": "object", "properties": {
        "ref": { "const": "refs/tags/playground-v0.1.0" }, "version": { "const": "0.2.3" }
      } } } }
    },
    {
      "if": { "properties": { "source": { "type": "object", "properties": { "ref": { "const": "refs/tags/playground-v0.1.0" } } } } },
      "then": { "properties": { "channel": { "const": "playground-0.1.0" } } }
    }
  ]
}
