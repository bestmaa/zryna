          "$ref": "#/$defs/u32"
        },
        "start": {
          "$ref": "#/$defs/u32"
        },
        "end": {
          "$ref": "#/$defs/u32"
        }
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "identifierText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "not": {
        "enum": [
          "__proto__",
          "prototype",
          "constructor"
        ]
      }
    },
    "identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "span"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/identifierText"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "nullableSpan": {
      "anyOf": [
        {
          "$ref": "#/$defs/span"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableU32": {
