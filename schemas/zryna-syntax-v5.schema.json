{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zryna.com/schemas/zryna-syntax-v5.schema.json",
  "title": "Zryna untrusted bounded-generics syntax protocol v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "files",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": 5
    },
    "files": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/sourceUnit"
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "start",
        "end"
      ],
      "properties": {
