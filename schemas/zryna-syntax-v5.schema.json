          "required": [
            "kind",
            "keyword_span"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "keyword_span": {
              "$ref": "#/$defs/span"
            }
          }
        },
        {
          "$ref": "#/$defs/singleArgumentTypeKind"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "keyword_span",
            "less_than_span",
            "element",
            "comma_span",
            "length_span",
