{
  "name": "zryna",
  "displayName": "Zryna Developer Preview",
  "description": "Syntax highlighting, M1–M3 formatting and explicit JavaScript/WebAssembly Run for Zryna.",
  "version": "0.5.0",
  "publisher": "zryna",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zryna/zryna.git",
    "directory": "editors/vscode-zryna"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./src/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onLanguage:zryna"
  ],
  "contributes": {
    "commands": [
      { "command": "zryna.selectEditorProfile", "title": "Zryna: Select Editor Profile" },
      { "command": "zryna.showGlobalDiagnostics", "title": "Zryna: Show Project Diagnostics" },
      { "command": "zryna.run", "title": "Zryna: Run Saved File" },
      { "command": "zryna.openGeneratedJavaScript", "title": "Zryna: Open Generated JavaScript" },
      { "command": "zryna.revealRunOutput", "title": "Zryna: Reveal Run Output" }
    ],
    "menus": {
      "editor/title": [{ "command": "zryna.run", "when": "editorLangId == zryna && isWorkspaceTrusted", "group": "navigation" }]
    },
    "grammars": [{ "language": "zryna", "scopeName": "source.zryna", "path": "./syntaxes/zryna.tmLanguage.json" }],
    "languages": [
      {
        "id": "zryna",
        "aliases": [
          "Zryna"
        ],
        "extensions": [
          ".zry"
        ]
      }
    ],
    "configuration": {
      "title": "Zryna",
      "properties": {
        "zryna.installationPath": {
          "type": "string", "default": "", "scope": "application",
          "description": "Absolute path to the independently verified complete portable setup."
        },
        "zryna.installationDigest": {
          "type": "string", "default": "", "scope": "application",
          "description": "Reviewed SHA-256 of setup.json supplied with the verified candidate."
        },
        "zryna.compilerPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Absolute installed v0.2.3 zryna compiler executable for explicit Run. Separate from the source-built language server."
        },
        "zryna.serverPath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Absolute path to the explicitly installed compatible zryna-language-server executable."
        },
        "zryna.compilerRoot": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Absolute trusted compiler checkout with the pinned adapter installed. Not the edited project root."
        },
        "zryna.nodePath": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Absolute path to the pinned Node.js 22.22.1 executable."
        }
      }
    }
  },
  "zrynaCompatibility": {
    "compilerVersion": "0.2.3",
    "requiredCapabilities": {
      "scalar-v2": "scalar-format-v1",
      "control-flow-v1": "control-flow-format-v1",
      "data-ownership-v1": "data-ownership-format-v1"
    },
    "serverVersion": "0.5.0",
    "installationCapability": "portable-setup-v1",
    "sourceBuildRequired": false,
    "releasedCompilerCompatible": true,
    "profiles": [
      "scalar-v2",
      "control-flow-v1",
      "data-ownership-v1"
    ]
  },
  "scripts": {
    "check": "node --check src/extension.cjs && node --check src/connection.cjs && node --check src/run-command.cjs && node --check src/run-input.cjs && node --check src/run-process.cjs && node --check src/run-project.cjs",
    "test": "node --test test/*.test.cjs",
    "package": "node ../../scripts/package-editor.mjs"
  }
}
