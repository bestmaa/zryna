{
  "$schema": "./schemas/zryna-workspace-v1.schema.json",
  "version": 1,
  "profile": "zryna-compiler-workspace-v1",
  "members": [
    {
      "id": "zryna-abi",
      "root": "crates/zryna-abi",
      "kind": "foundation",
      "dependencies": [],
      "allowedEntries": ["Cargo.toml", "README.md", "src"]
    },
    {
      "id": "zryna-diagnostics",
      "root": "crates/zryna-diagnostics",
      "kind": "foundation",
      "dependencies": ["zryna-source"],
      "allowedEntries": ["Cargo.toml", "README.md", "src"]
    },
    {
      "id": "zryna-source",
      "root": "crates/zryna-source",
      "kind": "foundation",
      "dependencies": [],
      "allowedEntries": ["Cargo.toml", "README.md", "src"]
    },
    {
      "id": "zryna-package",
      "root": "crates/zryna-package",
      "kind": "foundation",
      "dependencies": [],
      "allowedEntries": ["Cargo.toml", "README.md", "src", "tests"]
    },
    {
      "id": "zryna-process",
      "root": "crates/zryna-process",
      "kind": "foundation",
      "dependencies": [],
      "allowedEntries": ["Cargo.toml", "README.md", "src"]
    },
    {
      "id": "zryna-architecture",
      "root": "crates/zryna-architecture",
      "kind": "foundation",
      "dependencies": ["zryna-diagnostics", "zryna-process"],
      "allowedEntries": ["Cargo.toml", "README.md", "src"]
    },
    {
      "id": "zryna-syntax",
      "root": "crates/zryna-syntax",
      "kind": "foundation",
      "dependencies": ["zryna-diagnostics", "zryna-source"],
      "allowedEntries": ["Cargo.toml", "README.md", "src"]
    },
    {
      "id": "zryna-windows-filesystem",
      "root": "crates/zryna-windows-filesystem",
      "kind": "foundation",
      "dependencies": [],
      "allowedEntries": ["Cargo.toml", "README.md", "src", "tests"]
    },
    {
      "id": "zryna-frontend",
      "root": "crates/zryna-frontend",
      "kind": "frontend",
      "dependencies": ["zryna-diagnostics", "zryna-process", "zryna-source", "zryna-syntax"],
      "allowedEntries": ["Cargo.toml", "README.md", "src", "tests"]
    },
    {
      "id": "zryna-ir",
      "root": "crates/zryna-ir",
      "kind": "compiler",
      "dependencies": ["zryna-abi", "zryna-diagnostics", "zryna-layout", "zryna-source", "zryna-syntax"],
      "allowedEntries": ["Cargo.toml", "README.md", "src"]
    },
    {
      "id": "zryna-semantics",
      "root": "crates/zryna-semantics",
      "kind": "compiler",
      "dependencies": ["zryna-abi", "zryna-diagnostics", "zryna-ir", "zryna-layout", "zryna-ownership-runtime-abi", "zryna-source", "zryna-syntax"],
      "allowedEntries": ["Cargo.toml", "README.md", "src"]
    },
    {
      "id": "zryna-layout",
      "root": "crates/zryna-layout",
      "kind": "compiler",
      "dependencies": ["zryna-diagnostics", "zryna-source"],
      "allowedEntries": ["Cargo.toml", "README.md", "src"]
    },
    {
      "id": "zryna-ownership-runtime-abi",
      "root": "crates/zryna-ownership-runtime-abi",
      "kind": "compiler",
      "dependencies": ["zryna-layout", "zryna-source"],
      "allowedEntries": ["Cargo.toml", "README.md", "include", "src"]
    },
    {
      "id": "zryna-backend-javascript",
      "root": "crates/zryna-backend-javascript",
      "kind": "backend",
      "dependencies": ["zryna-diagnostics", "zryna-ir", "zryna-layout", "zryna-ownership-runtime-abi", "zryna-semantics", "zryna-source", "zryna-syntax"],
      "allowedEntries": ["Cargo.toml", "README.md", "src", "tests"]
    },
    {
      "id": "zryna-native-mir",
      "root": "crates/zryna-native-mir",
      "kind": "compiler",
      "dependencies": ["zryna-abi", "zryna-diagnostics", "zryna-ir", "zryna-layout", "zryna-ownership-runtime-abi", "zryna-semantics", "zryna-source", "zryna-syntax"],
      "allowedEntries": ["Cargo.toml", "README.md", "src", "tests"]
    },
    {
      "id": "zryna-backend-native",
      "root": "crates/zryna-backend-native",
      "kind": "backend",
      "dependencies": ["zryna-abi", "zryna-diagnostics", "zryna-ir", "zryna-native-mir", "zryna-semantics", "zryna-source", "zryna-syntax"],
      "allowedEntries": ["Cargo.toml", "README.md", "src", "tests"]
    },
    {
      "id": "zryna-backend-webassembly",
      "root": "crates/zryna-backend-webassembly",
      "kind": "backend",
      "dependencies": ["zryna-diagnostics", "zryna-ir", "zryna-layout", "zryna-ownership-runtime-abi", "zryna-semantics", "zryna-source", "zryna-syntax"],
      "allowedEntries": ["Cargo.toml", "README.md", "src", "tests"]
    },
    {
      "id": "zryna-driver",
      "root": "crates/zryna-driver",
      "kind": "orchestrator",
      "dependencies": [
        "zryna-abi",
        "zryna-architecture",
        "zryna-backend-javascript",
        "zryna-backend-native",
        "zryna-backend-webassembly",
        "zryna-diagnostics",
        "zryna-frontend",
        "zryna-ir",
        "zryna-native-mir",
        "zryna-package",
        "zryna-process",
        "zryna-semantics",
        "zryna-source",
        "zryna-syntax",
        "zryna-windows-filesystem"
      ],
      "allowedEntries": ["Cargo.toml", "README.md", "src"]
    },
    {
      "id": "zryna-language-server",
      "root": "apps/zryna-language-server",
      "kind": "application",
      "dependencies": ["zryna-driver", "zryna-source"],
      "allowedEntries": ["Cargo.toml", "README.md", "src", "tests"]
    },
    {
      "id": "zryna",
      "root": "apps/zryna",
      "kind": "application",
      "dependencies": ["zryna-abi", "zryna-architecture", "zryna-diagnostics", "zryna-driver", "zryna-package", "zryna-windows-filesystem"],
      "allowedEntries": ["Cargo.toml", "README.md", "src", "tests"]
    }
  ],
  "adapters": [
    {
      "id": "typescript-6",
      "root": "adapters/typescript-6",
      "protocolVersion": 2,
      "toolchain": "@typescript/typescript6@6.0.2",
      "allowedEntries": ["README.md", "package.json", "src", "test"]
    }
  ],
  "outputs": ["target", ".zryna/cache", ".zryna/out"]
}
