export function parallelSelect<T extends ZrynaValue>(flag:bool,value:T):i32 {
  const retained:String="保持";
  let left:Option<i32> =Option.some<i32>(71);
  let right:Option<i32> =Option.some<i32>(73);
  let first:Result<i32,bool> =Result.ok<i32,bool>(79);
  let second:Result<i32,bool> =Result.err<i32,bool>(false);
  if(flag) {
    const local:String="交";
    const savedOption:Option<i32> =left;
    left=right;
    right=savedOption;
    const savedResult:Result<i32,bool> =first;
    first=second;
    second=savedResult;
  } else {
    const local:String="";
    left=Option.none<i32>();
    second=Result.err<i32,bool>(true);
  }
  const a:i32=match(left,{"Option.none":()=>101,"Option.some":(payload)=>payload});
  const b:i32=match(right,{"Option.none":()=>103,"Option.some":(payload)=>payload});
  const c:i32=match(first,{"Result.ok":(payload)=>payload,"Result.err":(tag)=>truthCode<i32>(tag)});
  const d:i32=match(second,{"Result.ok":(payload)=>payload,"Result.err":(tag)=>truthCode<i32>(tag)});
  return a+b+b+c+c+c+d+d+d+d;
}
