    {"id": "compatibility-m1-native", "lane": "compatibility", "hosts": ["linux-x86_64"], "executable": "cargo", "args": ["test", "--locked", "-p", "zryna", "--test", "cli", "m1_linux_three_target_results_and_artifacts_match_every_fixture", "--", "--exact", "--nocapture"], "proof": "rust-tests", "timeoutMs": 900000},
