    {"id": "security-contracts", "lane": "security", "hosts": ["linux-x86_64", "windows-x86_64"], "executable": "node", "args": ["--test", "--test-reporter=tap", "tests/package-release-v1/validation.test.mjs", "tests/package-release-v1/boundaries.test.mjs", "tests/package-source-trust.test.mjs", "tests/wit-capability-contract.test.mjs", "tests/protected-release-build.test.mjs", "tests/release-evidence.test.mjs"], "proof": "node-tests", "timeoutMs": 600000},
    {"id": "security-authorities", "lane": "security", "hosts": ["linux-x86_64", "windows-x86_64"], "executable": "cargo", "args": ["test", "--locked", "-p", "zryna-source", "-p", "zryna-syntax", "-p", "zryna-frontend", "-p", "zryna-ir", "-p", "zryna-native-mir", "-p", "zryna-driver", "--", "--include-ignored"], "proof": "rust-tests", "timeoutMs": 7200000},
