    {"id": "performance-m1-compile-run", "lane": "performance", "hosts": ["linux-x86_64"], "executable": "cargo", "args": ["test", "--locked", "-p", "zryna", "--test", "cli", "m1_javascript_and_webassembly_match_every_portable_fixture", "--", "--exact", "--nocapture"], "proof": "rust-tests", "timeoutMs": 900000, "warmups": 1, "samples": 5, "method": "gnu-time-maxrss-kib-and-monotonic-wall-ms", "thresholds": null}
