export function option<T extends ZrynaValue>(value:Option<Option<String>>):Option<Option<String>> { const view:Borrow<Option<Option<String>>> =borrow(value); const first:Option<Option<String>> =match(view, { "Option.none": () => clone(value), "Option.some": (inner) => clone(value) }); const second:Option<Option<String>> =clone(value); return second; }
export function result<T extends ZrynaValue>(value:Result<Option<String>,Option<String>>):Result<Option<String>,Option<String>> { const view:Borrow<Result<Option<String>,Option<String>>> =borrow(value); const first:Result<Option<String>,Option<String>> =match(view, { "Result.ok": (inner) => clone(value), "Result.err": (inner) => clone(value) }); const second:Result<Option<String>,Option<String>> =clone(value); return second; }
export function makeOption<T extends ZrynaValue>(flag:bool):Option<Option<String>> { if(flag) { return Option.some<Option<String>>(Option.some<String>("入")); } return Option.some<Option<String>>(Option.some<String>("")); }
export function makeOk<T extends ZrynaValue>(flag:bool):Result<Option<String>,Option<String>> { if(flag) { return Result.ok<Option<String>,Option<String>>(Option.some<String>("成功")); } return Result.ok<Option<String>,Option<String>>(Option.some<String>("")); }
export function makeErr<T extends ZrynaValue>(flag:bool):Result<Option<String>,Option<String>> { if(flag) { return Result.err<Option<String>,Option<String>>(Option.some<String>("失敗")); } return Result.err<Option<String>,Option<String>>(Option.some<String>("")); }
export function discardOption<T extends ZrynaValue>(value:Option<Option<String>>):i32 { return match(value, { "Option.none": () => 3, "Option.some": (inner) => match(inner, { "Option.none": () => 5, "Option.some": (payload) => 7 }) }); }
export function discardResult<T extends ZrynaValue>(value:Result<Option<String>,Option<String>>):i32 { return match(value, { "Result.ok": (inner) => match(inner, { "Option.none": () => 11, "Option.some": (payload) => 13 }), "Result.err": (inner) => match(inner, { "Option.none": () => 17, "Option.some": (payload) => 19 }) }); }
