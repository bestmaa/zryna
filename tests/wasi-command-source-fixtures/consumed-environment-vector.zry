function consume(result: EnvLookupV1): bool {
  return match(result, {
    "EnvLookupV1.Found": (value) => true,
    "EnvLookupV1.Missing": () => false,
  });
}

export function main(): bool {
  const result: EnvLookupV1 = environmentLookup("MODE");
  const unrelated: Vec<String> = Vec<String>(["not-an-outcome",]);
  const accepted: bool = consume(result);
  const ignored: Vec<bool> = Vec<bool>([accepted,]);
  return accepted;
}
