export function single(flag:bool):i32 {
  const outer:String="outer";
  const original:String="入";
  const result:Result<String,i32> =singleSelect<String>(flag,original);
  return match(result,{"Result.ok":(value)=>discard<String>(value),"Result.err":(code)=>code});
}
