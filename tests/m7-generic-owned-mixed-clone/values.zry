export function left<T extends ZrynaValue>(value:Result<Option<String>,String>):Result<Option<String>,String> { const view:Borrow<Result<Option<String>,String>> =borrow(value); const first:Result<Option<String>,String> =match(view, { "Result.ok": (inner) => clone(value), "Result.err": (payload) => clone(value) }); const second:Result<Option<String>,String> =clone(value); return second; }
export function right<T extends ZrynaValue>(value:Result<String,Option<String>>):Result<String,Option<String>> { const view:Borrow<Result<String,Option<String>>> =borrow(value); const first:Result<String,Option<String>> =match(view, { "Result.ok": (payload) => clone(value), "Result.err": (inner) => clone(value) }); const second:Result<String,Option<String>> =clone(value); return second; }
export function makeLeftSome<T extends ZrynaValue>(flag:bool):Result<Option<String>,String> { if(flag) { return Result.ok<Option<String>,String>(Option.some<String>("成功")); } return Result.ok<Option<String>,String>(Option.some<String>("")); }
export function makeLeftString<T extends ZrynaValue>(flag:bool):Result<Option<String>,String> { if(flag) { return Result.err<Option<String>,String>("失敗"); } return Result.err<Option<String>,String>(""); }
export function makeRightString<T extends ZrynaValue>(flag:bool):Result<String,Option<String>> { if(flag) { return Result.ok<String,Option<String>>("直接"); } return Result.ok<String,Option<String>>(""); }
export function makeRightSome<T extends ZrynaValue>(flag:bool):Result<String,Option<String>> { if(flag) { return Result.err<String,Option<String>>(Option.some<String>("間接")); } return Result.err<String,Option<String>>(Option.some<String>("")); }
export function discardLeft<T extends ZrynaValue>(value:Result<Option<String>,String>):i32 { return match(value, { "Result.ok": (inner) => match(inner, { "Option.none": () => 11, "Option.some": (payload) => 13 }), "Result.err": (payload) => 19 }); }
export function discardRight<T extends ZrynaValue>(value:Result<String,Option<String>>):i32 { return match(value, { "Result.ok": (payload) => 23, "Result.err": (inner) => match(inner, { "Option.none": () => 29, "Option.some": (payload) => 31 }) }); }
